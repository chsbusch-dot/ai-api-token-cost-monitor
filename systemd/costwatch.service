[Unit]
Description=costwatch — AI cost monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/token-watch
# .env carries non-secret config only; credentials are fetched from Bitwarden
# Secrets Manager at start by the launcher (see scripts/costwatch-launch.sh).
EnvironmentFile=%h/token-watch/.env
ExecStart=%h/token-watch/scripts/costwatch-launch.sh
Restart=on-failure
RestartSec=5s
# Don't wait forever for SSE / long-poll connections to close on shutdown.
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
