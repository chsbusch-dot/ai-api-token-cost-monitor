[Unit]
Description=costwatch — AI cost monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/token-watch
EnvironmentFile=%h/token-watch/.env
ExecStart=%h/token-watch/.venv/bin/python -m costwatch
Restart=on-failure
RestartSec=5s
# Don't wait forever for SSE / long-poll connections to close on shutdown.
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=default.target
