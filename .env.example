# Admin API keys — read-only billing scope.
# Anthropic: console.anthropic.com → Settings → Admin Keys (org accounts only)
ANTHROPIC_ADMIN_API_KEY=

# OpenAI: platform.openai.com → Organization → Admin keys (org owner role)
OPENAI_ADMIN_API_KEY=

# Deepgram: console.deepgram.com → API Keys → create with Member or Owner role
# (default listen-only keys lack billing:read scope and can't read balance)
DEEPGRAM_ADMIN_API_KEY=

# SMTP (email digest + alerts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
DIGEST_FROM=
DIGEST_TO=

# Daily spend budgets in USD per provider, with comma-separated alert percentages.
# Format: <daily_usd>:<pct1>,<pct2>,...
# Example: alert at 80% and 100% of $10/day:
# BUDGET_ANTHROPIC=10:80,100
# BUDGET_OPENAI=10:80,100
# BUDGET_GEMINI=10:80,100
BUDGET_ANTHROPIC=
BUDGET_OPENAI=
BUDGET_GEMINI=

# URL printed in emails and used in budget alerts. Default: http://localhost:8000
DASHBOARD_URL=

# Polling interval for provider Cost APIs in seconds. Default: 60.
POLL_INTERVAL_SECONDS=

# Bind address for the web server. Defaults: 0.0.0.0 / 8000.
HOST=
PORT=
